{# 模块一：口语复述单元模板 (两页制) #}
<section class="rp rmat">
  {% if is_preview %}
  <div class="preview-header">
    <span>【单单元预览】复述单元 · {{ unit.id }}</span>
    <span>类别：{{ unit.category }}</span>
  </div>
  {% endif %}
  <div class="rhead">
    <h3>{{ unit.title }}</h3>
  </div>
  <div class="dateline">{{ unit.date_label }}</div>
  {% for para in unit.material_paragraphs %}
  <p class="matbody">{{ para }}</p>
  {% endfor %}
  <div class="src">{{ unit.source_label }}</div>
</section>

<section class="rp rhint">
  <div class="rhead">
    <h3>{{ unit.title }}</h3>
  </div>
  <div class="hint-blk">
    <div class="hint-cap">关键词网络</div>
    {{ keywords_svg | safe }}
  </div>
  <div class="hint-blk">
    <div class="hint-cap">思维导图</div>
    {{ mindmap_svg | safe }}
  </div>
  <div class="hint-blk">
    <div class="hint-cap">看图复述</div>
    {% if illustration_html %}
      {{ illustration_html | safe }}
    {% else %}
    <div class="illhold">
      <div class="ill-no">插画待回传</div>
      <div class="ill-note">{{ unit.illustration_brief or "黑白报刊式叙事插画" }}</div>
    </div>
    {% endif %}
  </div>
</section>
