{# 模块二：评论与即兴表达单元模板 (三页制) #}
{% set display_id = "C-单" if unit.id == "c-dan-jiao-xie" else unit.id %}
{% set is_unverified = is_unverified | default(false) %}

{# 页面 1：问题与材料回想 #}
<section class="cq">
  <div class="page-meta">
    <span class="meta-left">高中口语表达 · 评论单元{% if is_unverified %} <strong class="unverified-tag">【草稿·未核验】</strong>{% endif %}</span>
    <span class="meta-right">1 / 3</span>
  </div>
  <div class="cuhead">
    <span class="rno">{{ display_id }}</span>
    <h3>{{ unit.title }}</h3>
    {% if backref_page %}
    <span class="backref">关联材料见第 {{ backref_page }} 页</span>
    {% elif is_unverified %}
    <span class="backref unverified-backref">对应复述·{{ unit.retelling_ref }}（未核验）</span>
    {% elif retelling_title %}
    <span class="backref">关联材料：《{{ retelling_title }}》</span>
    {% else %}
    <span class="backref">关联材料：《{{ unit.title.split('：')[0].replace('“','').replace('”','') }}》</span>
    {% endif %}
  </div>
  <div class="cu-blk">
    <div class="lbl">回想材料</div>
    <ul class="recap">
      {% for fact in unit.learning.recap_facts %}
      <li>{{ fact }}</li>
      {% endfor %}
    </ul>
  </div>
  <div class="cu-blk">
    <div class="lbl">思考问题</div>
    <ol class="qs">
      {% for q in unit.learning.questions %}
      <li>
        <div class="q-text">{{ q }}</div>
        {% set line_count = 2 if unit.learning.questions|length >= 4 else 3 %}
        <div class="writing-area">
          {% for i in range(line_count) %}
          <div class="wl"></div>
          {% endfor %}
        </div>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

{# 页面 2：观点池与推演思考 #}
<section class="cview">
  <div class="page-meta">
    <span class="meta-left">高中口语表达 · 评论单元{% if is_unverified %} <strong class="unverified-tag">【草稿·未核验】</strong>{% endif %}</span>
    <span class="meta-right">2 / 3</span>
  </div>
  <div class="cuhead">
    <span class="rno">{{ display_id }}</span>
    <h3>{{ unit.title }} · 观点与推演</h3>
  </div>
  <div class="cu-blk">
    <div class="lbl">观点参考（多元思考方向）</div>
    {% if unit.learning.baseline_diagnostic %}
    <div class="baseline">{{ unit.learning.baseline_diagnostic }}</div>
    {% endif %}
    <ul class="views">
      {% for v in unit.learning.viewpoints %}
      <li class="view-item">
        <div class="view-claim"><b>{{ v.claim }}</b></div>
        <div class="how">
          <div class="how-row"><span class="how-tag">材料中的细节：</span><span class="how-txt">{{ v.evidence }}</span></div>
          {% if v.explanation %}
          <div class="how-row"><span class="how-tag">可以怎样理解：</span><span class="how-txt">{{ v.explanation }}</span></div>
          {% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% for lesson in unit.learning.reasoning_lessons %}
  <div class="cu-blk reason-blk">
    <div class="lbl">{{ lesson.title }}</div>
    <div class="reason-content">
      {% for p in lesson.deduction_text.split('\n\n') %}
        {% if p.strip() %}
        <p class="ctx reason">{{ p.strip() }}</p>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endfor %}
</section>

{# 页面 3：口语范本与拆解 #}
<section class="cscript">
  <div class="page-meta">
    <span class="meta-left">高中口语表达 · 评论单元{% if is_unverified %} <strong class="unverified-tag">【草稿·未核验】</strong>{% endif %}</span>
    <span class="meta-right">3 / 3</span>
  </div>
  <div class="cuhead">
    <span class="rno">{{ display_id }}</span>
    <h3>{{ unit.title }} · 口语范本与拆解</h3>
  </div>
  <div class="cu-blk">
    <div class="lbl">口语范本（两段主体展开）</div>
    <div class="cu-script">
      {% if unit.speech.main_claim %}
      <p>{{ unit.speech.main_claim.strip() }}</p>
      {% endif %}
      {% for b in unit.speech.body %}
        {% set claim_clean = b.claim.strip() %}
        {% for p in b.paragraphs %}
          {% set p_clean = p.strip() %}
          {% if loop.first %}
            {% if p_clean.startswith(claim_clean) %}
            <p><b>{{ claim_clean }}</b>{{ p_clean[claim_clean|length:].lstrip() }}</p>
            {% else %}
            <p><b>{{ claim_clean }}</b>{{ p_clean }}</p>
            {% endif %}
          {% else %}
          <p>{{ p_clean }}</p>
          {% endif %}
        {% endfor %}
      {% endfor %}
      {% if unit.speech.closing %}
      <p>{{ unit.speech.closing.strip() }}</p>
      {% endif %}
    </div>
  </div>
  {% if unit.teaching.spine %}
  <div class="cu-blk">
    <div class="lbl">全文主线</div>
    <p class="ctx">{{ unit.teaching.spine }}</p>
  </div>
  {% endif %}
  {% if unit.teaching.deconstruction %}
  <div class="cu-blk">
    <div class="lbl">教学拆解</div>
    <div class="decon-list">
      {% for item in unit.teaching.deconstruction %}
      <div class="decon-item">
        <p class="ctx"><b>{{ item.target }}</b>　{{ item.instruction }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</section>
