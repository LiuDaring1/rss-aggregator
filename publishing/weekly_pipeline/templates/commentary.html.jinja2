{# 模块二：评论与即兴表达单元模板 (三页制) #}
{# 页面 1：问题与材料回想 #}
<section class="cq">
  {% if is_preview %}
  <div class="preview-header">
    <span>【单单元预览】评论单元 · {{ unit.id }}{% if is_unverified %} <strong style="color: #c00; margin-left: 6px;">【草稿·未核验】</strong>{% endif %}</span>
    <span>对应复述：{{ unit.retelling_ref }}{% if is_unverified %}（未核验）{% endif %}</span>
  </div>
  {% endif %}
  <div class="cuhead">
    <span class="rno">{{ unit.id }}</span>
    <h3>{{ unit.title }}</h3>
    {% if backref_page %}
    <span class="backref">对应复述·{{ unit.retelling_ref }} 材料页（第 {{ backref_page }} 页）</span>
    {% elif is_unverified %}
    <span class="backref" style="color: #c00; font-weight: bold;">对应复述·{{ unit.retelling_ref }}（未核验）</span>
    {% else %}
    <span class="backref">对应复述·{{ unit.retelling_ref }} 材料页</span>
    {% endif %}
  </div>
  <div class="cu-blk">
    <div class="lbl">回想材料</div>
    <ul class="recap">
      {% for fact in unit.learning.recap_facts %}
      <li>{{ fact }}</li>
      {% endfor %}
    </ul>
  </div>
  <div class="cu-blk">
    <div class="lbl">思考问题</div>
    <ol class="qs">
      {% for q in unit.learning.questions %}
      <li>
        {{ q }}
        <div class="wl"></div>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

{# 页面 2：观点池与推演思考 #}
<section class="cview">
  <div class="cuhead">
    <span class="rno">{{ unit.id }}</span>
    <h3>{{ unit.title }} · 观点与推演</h3>
  </div>
  <div class="cu-blk">
    <div class="lbl">观点参考（多元思考方向）</div>
    {% if unit.learning.baseline_diagnostic %}
    <div class="baseline">{{ unit.learning.baseline_diagnostic }}</div>
    {% endif %}
    <ul class="views">
      {% for v in unit.learning.viewpoints %}
      <li>
        <b>{{ v.claim }}</b>
        <div class="how">
          依据与来源：{{ v.evidence }}
          {% if v.explanation %}
          ；说明：{{ v.explanation }}
          {% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% for lesson in unit.learning.reasoning_lessons %}
  <div class="cu-blk">
    <div class="lbl">{{ lesson.title }}</div>
    <p class="ctx reason">{{ lesson.deduction_text }}</p>
  </div>
  {% endfor %}
</section>

{# 页面 3：口语范本与拆解 #}
<section class="cscript">
  <div class="cuhead">
    <span class="rno">{{ unit.id }}</span>
    <h3>{{ unit.title }} · 口语范本与拆解</h3>
  </div>
  <div class="cu-blk">
    <div class="lbl">口语范本（双主体展开 · 约 2 分钟）</div>
    <div class="cu-script">
      {% for p in unit.get_spoken_paragraphs() %}
      <p>{{ p }}</p>
      {% endfor %}
    </div>
  </div>
  {% if unit.teaching.spine %}
  <div class="cu-blk">
    <div class="lbl">全文主线</div>
    <p class="ctx">{{ unit.teaching.spine }}</p>
  </div>
  {% endif %}
  {% if unit.teaching.deconstruction %}
  <div class="cu-blk">
    <div class="lbl">教学拆解</div>
    <div class="decon-list">
      {% for item in unit.teaching.deconstruction %}
      <div class="decon-item">
        <p class="ctx"><b>{{ item.target }}</b>　{{ item.instruction }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</section>
