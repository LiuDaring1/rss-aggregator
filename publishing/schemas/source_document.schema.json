{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "description": "稳定的文档唯一标识，如 src-ttzl-45288",
      "title": "Source Id",
      "type": "string"
    },
    "media": {
      "description": "媒体名称",
      "title": "Media",
      "type": "string"
    },
    "title": {
      "description": "原文标题",
      "title": "Title",
      "type": "string"
    },
    "url": {
      "description": "原始链接",
      "title": "Url",
      "type": "string"
    },
    "doc_type": {
      "default": "report",
      "enum": [
        "report",
        "commentary",
        "award",
        "mixed",
        "unknown"
      ],
      "title": "Doc Type",
      "type": "string"
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "原始报道发表时间 (YYYY-MM-DD)",
      "title": "Published At"
    },
    "event_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "真实事件发生时间",
      "title": "Event At"
    },
    "award_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "获奖/公示时间",
      "title": "Award At"
    },
    "fetched_at": {
      "description": "抓取留档时间 ISO 字符串",
      "title": "Fetched At",
      "type": "string"
    },
    "content": {
      "description": "清洗后的正文完整内容",
      "title": "Content",
      "type": "string"
    },
    "paragraphs": {
      "description": "正文分段列表",
      "items": {
        "type": "string"
      },
      "title": "Paragraphs",
      "type": "array"
    },
    "content_hash": {
      "description": "正文哈希（去空白 sha1）",
      "title": "Content Hash",
      "type": "string"
    },
    "status": {
      "default": "complete",
      "enum": [
        "complete",
        "summary",
        "supplement",
        "unknown"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "media",
    "title",
    "url",
    "fetched_at",
    "content",
    "content_hash"
  ],
  "title": "SourceDocument",
  "type": "object"
}